# .keep files matching expressions for the 'find' command:
# - find . $(cat .keep)
# 
-path \*__pycache__
-o \(
 # preserve project paths:
 ! -path .
 ! -path ./.git\*
 ! -path ./.vscode\*
 ! -path ./.devcontainer\*
 # 
 # preserve project folders (top-level only):
 ! -path ./src
 ! -path ./tests
 ! -path ./docs
 # 
 # preserve files in project folder:
 ! -name .keep
 ! -name Makefile
 ! -name README.md
 ! -name requirements.txt
 ! -path ./pytest.ini
 ! -path ./docs/index.rst
 ! -name \*.py
 ! -name \*.tar
 # 
 # preserve packages under 'src'
 ! -path ./\*/calculator
 ! -path ./\*/collections
 ! -path ./\*/expressions
 ! -path ./\*/recursion
 ! -path ./\*/data-streams

 # preserve other project folders
 ! -path ./markup\*
 ! -path ./tmp\*
 ! -path ./branches\*

 # find: exclude files that are removed with the directory
 ! -path \*__pycache__/*
 ! -path ./.pytest_cache/\*
 ! -path \*.egg-info/\*
 ! -path \*doctrees/\*
 ! -path \*html/\*
\)
